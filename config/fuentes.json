      "proveedor": "ArgentinaDatos (datos INDEC)",
      "url": "https://api.argentinadatos.com/v1/finanzas/indices/inflacion",
      "nota": "Variación mensual del IPC. INDEC publica el dato del mes anterior alrededor del día 14."
    },
    "futbol_tabla": {
      "proveedor": "ESPN (API pública no documentada)",
      "url": "https://site.api.espn.com/apis/v2/sports/soccer/{liga}/standings",
      "nota": "Contrastar siempre con Promiedos o la Liga Profesional antes de publicar"
    },
    "futbol_fixture": {
      "proveedor": "ESPN (API pública no documentada)",
      "url": "https://site.api.espn.com/apis/site/v2/sports/soccer/{liga}/teams/{team_id}/schedule",
      "nota": "Sólo trae la competición indicada. El próximo partido se verifica además en bocajuniors.com.ar y un medio deportivo."
    }
  },

