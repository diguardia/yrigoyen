{
  "apis": {
    "clima": {
      "proveedor": "Open-Meteo",
      "url": "https://api.open-meteo.com/v1/forecast?latitude={lat}&longitude={lon}&daily=weather_code,temperature_2m_max,temperature_2m_min,precipitation_sum,precipitation_probability_max,wind_speed_10m_max,wind_gusts_10m_max&timezone=America%2FArgentina%2FCordoba&forecast_days={dias}&past_days={previos}",
      "codigos": "WMO 4677 (weather_code)",
