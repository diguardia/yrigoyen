      "limite": "Aproximadamente 30 llamadas por minuto sin clave; esperar 2 s entre llamadas"
    },
    "cripto_historico": {
      "proveedor": "CoinGecko (API pública)",
      "url": "https://api.coingecko.com/api/v3/coins/{id}/market_chart?vs_currency=usd&days={dias}",
      "nota": "days=365 devuelve puntos diarios; days=7 devuelve puntos horarios. Si falla por límite, derivar 7 y 30 días de la serie de 365."
    },
    "dolar": {
      "proveedor": "DolarApi",
      "url": "https://dolarapi.com/v1/dolares",
